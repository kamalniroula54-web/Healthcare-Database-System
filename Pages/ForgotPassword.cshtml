@page
@model ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot password";
}
<section class="auth-card">
	<p class="eyebrow">ACCOUNT RECOVERY</p>
	<h1>Forgot your password?</h1>
	@if (Model.RequestSubmitted)
	{
		<div class="notice" role="status">
			@if (Model.SubmittedContactMethod == "Email")
			{
				<p>If an eligible account matches that username and Outlook delivery is available, a one-time password will be sent to the email address on file. Sign in with it and choose a new password.</p>
				<p>If no email arrives or you cannot access that email, contact an administrator through another trusted channel.</p>
			}
			else
			{
				<p>If an eligible account matches that username, an administrator will review the phone recovery request and verify your identity before sharing a reset code.</p>
			}
		</div>
	}
	else
	{
		<p class="muted">Use your account username and choose the recovery method you can access.</p>
		<form method="post">
			<div asp-validation-summary="ModelOnly" class="validation"></div>
			<label asp-for="Input.Username">Employee or administrator username</label>
			<input asp-for="Input.Username" autocomplete="username" required />
			<span asp-validation-for="Input.Username" class="validation"></span>
			<label asp-for="Input.ContactMethod">Preferred recovery method</label>
			<select asp-for="Input.ContactMethod" required>
				<option value="">Choose email or phone</option>
				<option value="Email">Email address on my profile</option>
				<option value="Phone">Phone number on my profile</option>
			</select>
			<span asp-validation-for="Input.ContactMethod" class="validation"></span>
			<button class="button full-width" type="submit">Request password reset</button>
		</form>
	}
	<section class="card">
		<h2>Can't access your profile email?</h2>
		<p class="muted">
			Contact an administrator through another trusted channel. They will verify your identity and
			share a reset code through an approved alternative. If you are the only administrator, contact
			the local system owner.
		</p>
	</section>
	<section class="card">
		<h2>Administrator recovery</h2>
		<p class="muted">If you cannot access your profile email, ask another administrator to verify your identity and reset your account.</p>
	</section>
	@if (!Model.RequestSubmitted)
	{
		<p class="muted">Email recovery uses the administrator-connected Outlook account. If an OTP does not arrive, contact an administrator.</p>
	}
	<a class="button full-width" asp-page="/Login">Return to sign in</a>
</section>
