@page
@model ChangePasswordModel
@{
    ViewData["Title"] = "Complete account setup";
}
<section class="form-card">
	<p class="eyebrow">ACCOUNT SETUP</p>
	<h1>@(Model.RequiresPasswordChange ? "Complete your account setup" : "Complete your profile")</h1>
	@if (Model.RequiresPasswordChange)
	{
		<p class="muted">Enter your profile information and choose a personal password before continuing.</p>
	}
	else
	{
		<p class="muted">Enter your profile information before continuing.</p>
	}
	<form method="post">
		<div asp-validation-summary="ModelOnly" class="validation"></div>
		<partial name="_EmployeeProfileFields" for="Profile" />
		@if (Model.RequiresPasswordChange)
		{
			<label asp-for="Password">New password</label>
			<input asp-for="Password" type="password" autocomplete="new-password" minlength="12" maxlength="128" required />
			<span asp-validation-for="Password" class="validation"></span>
			<label asp-for="ConfirmPassword">Confirm new password</label>
			<input asp-for="ConfirmPassword" type="password" autocomplete="new-password" required />
			<span asp-validation-for="ConfirmPassword" class="validation"></span>
		}
		<div class="form-actions">
			<button class="button" type="submit">@(Model.RequiresPasswordChange ? "Save profile and password" : "Save profile")</button>
		</div>
	</form>
</section>
