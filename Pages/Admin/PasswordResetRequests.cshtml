@page
@model PasswordResetRequestsModel
@{
    ViewData["Title"] = "Password reset requests";
}
<div class="page-heading">
	<div>
		<p class="eyebrow">ADMINISTRATION</p>
		<h1>Password reset requests</h1>
		<p class="muted">Email requests send automatically. Verify identity before issuing a code through the manual phone fallback.</p>
	</div>
</div>
@if (!string.IsNullOrEmpty(Model.TemporaryPassword))
{
	<section class="notice" role="status">
		<h2>One-time password issued for @Model.ResetUsername</h2>
		<p>Verify the account holder's identity before sharing this OTP.</p>
		@if (!string.IsNullOrWhiteSpace(Model.ResetDeliveryError))
		{
			<p class="alert">Automatic email delivery failed (@Model.ResetDeliveryError). Use the verified fallback below.</p>
			<a asp-page="/Admin/OutlookEmail">Check Outlook email settings</a>
		}
		@if (Model.ResetContactMethod == "Email")
		{
			<p>
				Automatic delivery failed. Review a fallback email draft to
				<strong>@(string.IsNullOrWhiteSpace(Model.ResetEmail) ? "the address on file (unavailable)" : Model.ResetEmail)</strong>,
				or use another verified channel.
			</p>
			@if (Model.EmailDraftUrl is not null)
			{
				<a class="button secondary" href="@Model.EmailDraftUrl">Open email draft</a>
			}
		}
		else
		{
			<p>Share the OTP by phone at <strong>@(string.IsNullOrWhiteSpace(Model.ResetPhone) ? "No phone number is on file" : PhoneNumberSupport.FormatInternational(Model.ResetPhone))</strong>.</p>
		}
		<label for="temporary-password">One-time password (OTP)</label>
		<div class="otp-copy-row">
			<input id="temporary-password" type="text" value="@Model.TemporaryPassword" readonly onfocus="this.select()" aria-describedby="otp-copy-status" />
			<button id="copy-otp" type="button">Copy OTP</button>
		</div>
		<p id="otp-copy-status" aria-live="polite">Select the field to copy manually if the copy button is unavailable.</p>
	</section>
	<script>
		document.getElementById("copy-otp").addEventListener("click", async function () {
			const otpInput = document.getElementById("temporary-password");
			const copyStatus = document.getElementById("otp-copy-status");
			otpInput.select();
			try {
				await navigator.clipboard.writeText(otpInput.value);
				copyStatus.textContent = "OTP copied to clipboard.";
			} catch {
				copyStatus.textContent = "Automatic copy is unavailable. The OTP is selected; copy it manually.";
			}
		});
	</script>
}
@if (Model.Requests.Count == 0)
{
	<div class="card empty-state">
		<h2>No pending requests</h2>
		<p>New account recovery requests will appear here.</p>
	</div>
}
else
{
	<div class="table-wrap">
		<table>
			<thead>
				<tr>
					<th>Username</th>
					<th>Role</th>
					<th>Requested</th>
					<th>Preferred method</th>
					<th>Email on file</th>
					<th>Phone on file</th>
					<th>Delivery status</th>
					<th></th>
				</tr>
			</thead>
			<tbody>
			@foreach (PasswordResetRequest request in Model.Requests)
			{
				<tr>
					<td>@request.Username</td>
					<td>@request.AccountRole</td>
					<td>@request.RequestedAtUtc.ToString("yyyy-MM-dd HH:mm") UTC</td>
					<td>@request.ContactMethod</td>
					<td>@(string.IsNullOrWhiteSpace(request.Email) ? "Not provided" : request.Email)</td>
					<td>@(string.IsNullOrWhiteSpace(request.Phone) ? "Not provided" : PhoneNumberSupport.FormatInternational(request.Phone))</td>
					<td>@(request.DeliveryStatus == "Failed" ? $"Failed: {request.DeliveryError}" : request.DeliveryStatus)</td>
					<td>
						@if (request.DeliveryStatus == "Sending")
						{
							<span>Sending email...</span>
						}
						else if (request.AccountRole == UserRoles.Admin &&
							string.Equals(request.Username, User.Identity?.Name, StringComparison.OrdinalIgnoreCase))
						{
							<span>Ask another administrator</span>
						}
						else
						{
							<form method="post" asp-page-handler="IssueReset" asp-route-id="@request.Id">
								<button class="button secondary" type="submit">Verify and issue OTP</button>
							</form>
						}
					</td>
				</tr>
			}
			</tbody>
		</table>
	</div>
}
