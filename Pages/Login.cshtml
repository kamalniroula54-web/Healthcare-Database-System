@page
@model LoginModel
@{
    ViewData["Title"] = "Sign in";
}
<section class="auth-card">
	<p class="eyebrow">MK HOSPITAL</p>
	<h1>Sign in</h1>
	<p class="muted">Use the administrator account configured by the site owner.</p>
	@if (!string.IsNullOrEmpty(Model.ErrorMessage))
	{
		<div class="alert" role="alert">@Model.ErrorMessage</div>
	}
	<form method="post">
		<input type="hidden" asp-for="ReturnUrl" />
		<label asp-for="Username">Username</label>
		<input asp-for="Username" autocomplete="username" required />
		<label asp-for="Password">Password</label>
		<input asp-for="Password" type="password" autocomplete="current-password" required />
		<button class="button full-width" type="submit">Sign in</button>
	</form>
</section>
